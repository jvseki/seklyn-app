# Banco de dados
DATABASE_URL=postgresql+psycopg2://seklyn:seklyn@localhost:5432/seklyn

# Segurança / JWT
JWT_SECRET=troque-este-valor-por-uma-string-aleatoria-longa
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Frontend (para CORS e links gerados, ex: link do aluno)
FRONTEND_URL=http://localhost:5500

# Stripe (use as chaves de TESTE em desenvolvimento — pk_test_/sk_test_)
STRIPE_SECRET_KEY=sk_test_substitua
STRIPE_PUBLISHABLE_KEY=pk_test_substitua
STRIPE_WEBHOOK_SECRET=whsec_substitua
STRIPE_PRICE_ID=price_substitua

# Chave simples pra ativar/desativar assinatura manualmente via /api/admin
# (enquanto o pagamento é combinado fora do site). Gere um valor aleatório.
ADMIN_SECRET_KEY=troque-por-uma-string-aleatoria-so-sua

# Assistente virtual (mentor de uso do site) — chave da Gemini API
# (https://aistudio.google.com/apikey). Sem essa chave, o assistente
# simplesmente fica indisponível, o resto do site funciona normal.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
