# Banco de dados
DATABASE_URL=postgresql+psycopg2://seklyn:seklyn@localhost:5432/seklyn

# Segurança / JWT
JWT_SECRET=troque-este-valor-por-uma-string-aleatoria-longa
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Frontend (para CORS e links gerados, ex: link do aluno)
FRONTEND_URL=http://localhost:5500

# Mercado Pago (credenciais em mercadopago.com.br/developers > Suas integrações).
# Use as de TESTE (TEST-...) em desenvolvimento. NUNCA commite as de produção.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
# Horas depois do pagamento em que cancelar ainda devolve o dinheiro (0 = sem reembolso)
REEMBOLSO_HORAS=10
# Pix/débito: dias antes do vencimento em que aparece o aviso de pagar o próximo mês
DIAS_ALERTA_VENCIMENTO=5

# E-mail (Resend). Sem chave, o e-mail só aparece no log.
RESEND_API_KEY=
EMAIL_FROM=Seklyn <naoresponda@seklyn.com.br>

# Chave simples pra ativar/desativar assinatura manualmente via /api/admin
# (enquanto o pagamento é combinado fora do site). Gere um valor aleatório.
ADMIN_SECRET_KEY=troque-por-uma-string-aleatoria-so-sua
